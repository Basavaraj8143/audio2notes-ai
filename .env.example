# Mistral (primary for notes generation)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Local alias supported by code (if you already use this key name)
# MISTRELL_MODEL_API_KEY=your_mistral_api_key_here

# OpenRouter fallback
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=Audio2Notes AI
OPENROUTER_FREE_ONLY=true

# Optional local Ollama fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2:latest

# CORS
# For local development:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# For Vercel + Render production, replace with your Vercel frontend URL:
# CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional regex for preview deployments. Default code also allows *.vercel.app unless overridden.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL_SIZE=base

# Audio processing
AUDIO_SAMPLE_RATE=16000
AUDIO_TEMP_DIR=temp_audio

# Chunking and transcript sizing
MIN_SILENCE_LEN_MS=700
SILENCE_THRESH_DB=-40
KEEP_SILENCE_MS=300
MIN_CHUNK_LEN_MS=45000
MAX_CHUNK_LEN_MS=120000
MAX_WORDS_PER_CHUNK=500

# Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_DIR=faiss_index

# Session persistence
SESSION_DB_PATH=backend/session_store.db
